{
  "name": "@canvas-glide/solid",
  "version": "1.0.2",
  "description": "Solid components for canvas-glide: pan, zoom and pinch-to-zoom for images on a canvas, an img or a scrolled view, with mouse, touch, pen and wheel input.",
  "keywords": [
    "solid",
    "solidjs",
    "solid-component",
    "pan-zoom",
    "panzoom",
    "pinch-zoom",
    "pinch-to-zoom",
    "zoom",
    "pan",
    "image-viewer",
    "image-zoom",
    "canvas",
    "gestures",
    "touch",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/vrtexe/canvas-glide-solid#readme",
  "bugs": {
    "url": "https://github.com/vrtexe/canvas-glide-solid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrtexe/canvas-glide-solid.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/canvas-glide.js",
  "types": "./dist/canvas-glide.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/canvas-glide.d.ts",
      "default": "./dist/canvas-glide.js"
    }
  },
  "scripts": {
    "check": "tsc -b",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "canvas-glide": "^1.0.1"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "jsdom": "^31.0.1",
    "solid-js": "^1.9.14",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^5.1.0"
  }
}
